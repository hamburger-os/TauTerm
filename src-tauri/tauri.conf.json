{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauTerm",
  "version": "0.6.1",
  "identifier": "com.tauterm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run check-com0com && npm run check-reserved-region && npm run build",
    "beforeDevCommand": "node scripts/prepare-service-bin.js --trdp-only && npm run dev",
    "beforeBundleCommand": "node scripts/generate-third-party-notices.js && node scripts/prepare-service-bin.js"
  },
  "app": {
    "windows": [
      {
        "title": "TauTerm",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "../src/assets/icons/logo.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/tauterm-trdp-bridge"
    ],
    "resources": {
      "../LICENSE": "LICENSE-MIT",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "vendor/tcnopen/LICENSE": "THIRD_PARTY_TCNOPEN_MPL-2.0.txt",
      "generated/THIRD_PARTY_DEPENDENCY_LICENSES.txt": "THIRD_PARTY_DEPENDENCY_LICENSES.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRTVENDU3MjFDNjc0MDAKUldRQWRNWWhWOVRsbmtsRi9JWnUvVGt1dHl0K1A5YytWNUlxOXVyZTl1YURvMzBuSDVWUm9rYk4K",
      "endpoints": [
        "https://github.com/hamburger-os/TauTerm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
