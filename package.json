{
  "name": "tauterm",
  "private": true,
  "version": "0.5.2",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build --config src-tauri/tauri.dev.conf.json --bundles nsis",
    "build:release": "node scripts/build-release.js",
    "check-com0com": "node scripts/check-com0com.js",
    "check:icons": "node scripts/check-icons.mjs",
    "check:session-buffer": "node --experimental-strip-types scripts/test-pending-session-data.mjs",
    "check:split-layout": "node --experimental-strip-types scripts/test-split-layout.mjs",
    "prompt:icon": "node scripts/icon-prompt.mjs",
    "preview:icons": "node scripts/preview-icons.mjs",
    "check-reserved-region": "node scripts/check-reserved-region.js",
    "toolchain:check": "node scripts/check-rust-toolchain.js",
    "version:check": "node scripts/check-version.js",
    "release:check": "node scripts/check-version.js --release",
    "postversion": "node scripts/sync-version.js",
    "version:sync": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "framer-motion": "^12.40.0",
    "i18next": "^23.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
